// SlopOS Waybar-compatible top bar seed.
{
    "position": "top",
    "height": 40,
    "spacing": 10,

    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "clock"
    ],

    "niri/workspaces": {
        "format": "{value}",
        "tooltip": false
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 32
    },
    "network": {
        "format-disconnected": "NET --",
        "interval": 5,
        "tooltip": false
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 10,
        "tooltip": false
    },
    "memory": {
        "format": "MEM {percentage}%",
        "interval": 30,
        "tooltip": false
    },
    "clock": {
        "format": "UTC",
        "interval": 60,
        "tooltip": false
    }
}
